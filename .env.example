# =========================================================
# SIRKULA ENVIRONMENT CONFIGURATION
# =========================================================

# 1. DATABASE CONNECTION (Supabase / PostgreSQL)
# For Supabase: Project Settings -> Database -> Connection string -> URI (Transaction pooler for DATABASE_URL, Session/Direct for DIRECT_URL)
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# 2. JWT AUTHENTICATION SECRET KEY
JWT_SECRET="sirkula-super-secure-production-jwt-token-key-2026"

# 3. AI SCANNER & ECOBOT (Google Gemini API)
NEXT_PUBLIC_GEMINI_API_KEY=""

# 4. APP BASE URL
NEXT_PUBLIC_APP_URL="http://localhost:3524"
