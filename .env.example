# ================================================================
# SIRKULA — Environment Variables Template
# Salin file ini ke .env dan isi nilai yang sesuai
# JANGAN commit file .env ke GitHub!
# ================================================================

# ----------------------------------------------------------------
# DATABASE (PostgreSQL via Supabase — https://supabase.com)
# ----------------------------------------------------------------
# Cara mendapatkan:
# 1. Buka project Supabase → Settings → Database → Connection String
# 2. Pilih mode "Transaction Pooler" untuk DATABASE_URL
# 3. Pilih mode "Session" atau "Direct" untuk DIRECT_URL
DATABASE_URL="postgresql://[user]:[password]@[host]:[port]/[dbname]?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://[user]:[password]@[host]:[port]/[dbname]"

# LOKAL (dev):
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sirkula_dev?schema=public"
# DIRECT_URL="postgresql://postgres:postgres@localhost:5432/sirkula_dev?schema=public"

# ----------------------------------------------------------------
# JWT SECRET — Wajib diganti di production!
# Generate: openssl rand -base64 64
# ----------------------------------------------------------------
JWT_SECRET="ganti-dengan-secret-random-minimal-32-karakter-dan-jaga-kerahasiaannya"

# ----------------------------------------------------------------
# APP URL — URL publik aplikasi
# ----------------------------------------------------------------
NEXT_PUBLIC_APP_URL="https://sirkula.vercel.app"

# LOKAL:
# NEXT_PUBLIC_APP_URL="http://localhost:3524"
